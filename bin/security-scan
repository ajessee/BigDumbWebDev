#!/bin/sh
set -eu

bundle exec brakeman --no-pager --quiet --exit-on-warn --exit-on-error
bundle exec bundler-audit check --update

# --groups dependencies excludes devDependencies (webpack-dev-server and its own,
# much larger, separate vulnerability set) - dev-server code never ships or runs
# outside a local dev container, so it isn't part of this gate. Yarn Classic (v1) has
# no per-advisory allowlist mechanism, so this step stays informational only (not
# gating) as a general policy - review its output by hand for anything new; see
# docs/development/SECURITY-ACCEPTANCE.md.
yarn audit --level high --groups dependencies || true
