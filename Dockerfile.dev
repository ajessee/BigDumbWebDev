# Rebuilt at each Rails/Ruby step of the version climb per docs/development/UPGRADE-PLAN.md,
# not maintained as a long-term image.
#
# Ruby 3.3.9 on Debian Bullseye: bumped from 3.0.7 as part of the Rails 7.1 -> 7.2 step,
# since Rails 7.2 requires Ruby >= 3.1. Matches RDJesseeBlog's own path through this same
# transition (3.0.7 -> 3.3.12 -> 4.0.6) - 4.x deferred until the Rails 8.x steps.
FROM ruby:3.3.9-bullseye

# Bullseye's security channel has moved off deb.debian.org's live mirror; the image ships
# commented-out snapshot.debian.org lines pinned to its own build date, so use those
# instead (same fix as Buster needed, one Debian release later).
RUN sed -i \
      -e '/^deb http:\/\/deb.debian.org\/debian bullseye main/d' \
      -e '/^deb http:\/\/deb.debian.org\/debian-security/d' \
      -e '/^deb http:\/\/deb.debian.org\/debian bullseye-updates/d' \
      -e 's/^# //' \
      /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      chromium \
      chromium-driver \
      curl \
      git \
    && rm -rf /var/lib/apt/lists/*

# Node 24.21.0 per .nvmrc (bumped from the EOL Node 12 pin as part of replacing
# Webpacker - Shakapacker needs a modern Node; 24 "Krypton" is the current active LTS,
# not just the next number up). Installed from the official release tarball; picks the
# right arch tarball so this also works on Apple Silicon dev machines.
RUN NODE_ARCH=$(case "$(uname -m)" in aarch64|arm64) echo arm64 ;; *) echo x64 ;; esac) \
    && curl -fsSL "https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-${NODE_ARCH}.tar.xz" -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && npm install -g yarn@1.22.19

ENV CHROME_BIN=/usr/bin/chromium
ENV BUNDLE_PATH=/usr/local/bundle

WORKDIR /app

# Ruby 3.3.9 ships a modern RubyGems/Bundler already (3.5.22 / 2.5.22) - the
# gem update --system / bundler 2.2.6 pin that Ruby 3.0.7 needed is no longer necessary.
# Bundler itself isn't a Gemfile-declared runtime dependency (it's the tool that reads the
# Gemfile, and boots before any Gemfile-declared gem activates), so bumping it doesn't hit
# the same "already activated X, but Gemfile requires Y" class of conflict the logger/
# mutex_m/psych pins above exist to avoid - just install the newer version directly.
# Latest 2.x, not 4.x (Bundler skipped 3.x entirely): no reason found yet to chase a new
# major, matching this app's own stance on Ruby 4.x.
RUN gem install bundler -v 2.7.2
# Ruby's own bundled default (2.5.22) still wins for a bare `bundle` invocation even with
# 2.7.2 also installed - BUNDLER_VERSION forces every `bundle` command in this image
# (including the lock/install below) to actually activate 2.7.2, so a from-scratch image
# build keeps recording BUNDLED WITH 2.7.2 in Gemfile.lock rather than silently reverting
# to the Ruby-bundled default on every rebuild.
ENV BUNDLER_VERSION=2.7.2

# Copy full source (not just Gemfile/Gemfile.lock) before bundle/yarn install, since the
# lockfile update below needs to persist into this layer rather than be clobbered by a
# later COPY of the host's stale copy.
COPY . .

# Adding selenium-webdriver ~> 4.0 (replacing webdrivers) needs rexml >= 3.2.5, newer
# than the lockfile's pinned 3.2.4. Rails also needs bumping to its latest 6.1.x patch
# (still Rails 6.1, not a version-climb step) since the original 6.1.3 lockfile pins
# activestorage -> marcel -> mimemagic 0.3.5, which was yanked from RubyGems. nokogiri is
# re-resolved too so its precompiled binary matches this platform's glibc, not a stale
# platform pin from an earlier lock attempt. bcrypt/mini_magick/image_processing/
# aws-sdk-s3/diffy bumped to current as part of the "remaining gems" pass at the end of
# the Rails/Ruby version climb - pg/jbuilder/bootsnap were already at latest, included
# here anyway so the lockfile is regenerated with the full final toolchain in one pass.
RUN bundle lock --update rexml selenium-webdriver rails logger nokogiri bootsnap minitest-reporters capybara mutex_m listen puma pg pry pry-byebug byebug minitest jbuilder json rack-proxy bcrypt mini_magick image_processing aws-sdk-s3 diffy \
    && bundle lock --add-platform x86_64-linux --add-platform aarch64-linux \
    && bundle install

RUN yarn install

EXPOSE 3000 3001 3035
